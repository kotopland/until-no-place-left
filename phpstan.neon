includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7
    phpVersion: 80400

    ignoreErrors:
        -
            identifier: missingType.generics
            path: app/Models/*
